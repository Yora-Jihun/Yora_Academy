---
import DocsLayout from '@/layouts/DocsLayout.astro'

const routingCode = `<?php
use Illuminate\Support\Facades\Route;

Route::get('/courses', [CourseController::class, 'index']);
Route::get('/courses/{id}', [CourseController::class, 'show']);
Route::post('/courses', [CourseController::class, 'store']);`

const controllerCode = `<?php
namespace App\Http\Controllers;

use App\Models\Course;
use Illuminate\Http\Request;

class CourseController extends Controller
{
    public function index()
    {
        $courses = Course::all();
        return view('courses.index', compact('courses'));
    }
}`
---

<DocsLayout>
  <h1 id="laravel">Laravel</h1>
  
  <h2 id="overview">Overview</h2>
  <p>Laravel is a web application framework with expressive, elegant syntax. It provides a clean and simple alternative to PHP without sacrificing power.</p>
  
  <h2 id="routing">Routing</h2>
  <pre class="bg-gray-900 dark:bg-gray-800 text-gray-100 dark:text-gray-200 p-4 rounded-lg overflow-x-auto"><code set:html={routingCode}></code></pre>
  
  <h2 id="controllers">Controllers</h2>
  <pre class="bg-gray-900 dark:bg-gray-800 text-gray-100 dark:text-gray-200 p-4 rounded-lg overflow-x-auto"><code set:html={controllerCode}></code></pre>
</DocsLayout>