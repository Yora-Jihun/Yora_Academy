---
import '../styles/global.css'
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Yora Academy - Open Source Learning Platform</title>
  </head>
  <body class="bg-white dark:bg-gray-900 min-h-screen font-inter overflow-x-hidden">
    <div class="fixed inset-0 -z-10 bg-grid-faded opacity-15 pointer-events-none overflow-hidden"></div>
    <div class="absolute top-1/2 right-0 -translate-y-1/2 translate-x-1/4 w-48 h-48 sm:w-64 sm:h-64 md:w-80 md:h-80 lg:w-[600px] lg:h-[600px] bg-blue-500/15 rounded-full blur-3xl pointer-events-none max-w-full dark:bg-blue-500/20"></div>
    
    <header class="container mx-auto px-4 md:px-6 py-4 lg:py-6 flex items-center justify-between w-full box-border">
      <a href="/" class="flex items-center gap-2 lg:gap-3 min-w-0">
        <img src="/assets/yora-logo.jpg" alt="Yora Academy Logo" class="h-7 lg:h-8 w-auto rounded-full flex-shrink-0" />
        <span class="text-lg lg:text-xl font-bold text-gray-900 dark:text-gray-100 truncate">Yora Academy</span>
      </a>
      
      <nav class="hidden md:flex items-center gap-6 lg:gap-8 flex-shrink-0" id="desktop-nav">
        <a href="/docs" class="text-sm lg:text-base text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition whitespace-nowrap">Docs</a>
        <a href="/docs" class="text-sm lg:text-base text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition whitespace-nowrap">Features</a>
        <a href="/docs" class="text-sm lg:text-base text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition whitespace-nowrap">Roadmap</a>
        <a href="/docs" class="text-sm lg:text-base text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition whitespace-nowrap">Community</a>
        <a href="/docs" class="text-sm lg:text-base text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition whitespace-nowrap">Contribute</a>
      </nav>
      
      <div class="flex md:hidden items-center gap-2 flex-shrink-0">
        <button id="mobile-theme-toggle" class="p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle theme">
          <img src="/dark-theme-svgrepo-com.svg" alt="Dark theme" class="w-4 h-4" id="mobile-icon-dark" />
          <img src="/moon-dark-theme-svgrepo-com.svg" alt="Light theme" class="w-4 h-4 hidden" id="mobile-icon-light" />
        </button>
        <button id="mobile-menu-btn" class="p-1.5 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition" aria-label="Menu">
          <svg class="w-5 h-5 text-gray-600 dark:text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
      
      <div class="hidden md:flex items-center gap-2 lg:gap-3 flex-shrink-0">
        <button id="theme-toggle" class="p-1.5 lg:p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" aria-label="Toggle theme">
          <img src="/dark-theme-svgrepo-com.svg" alt="Dark theme" class="w-4 lg:w-5 h-4 lg:h-5" id="icon-dark" />
          <img src="/moon-dark-theme-svgrepo-com.svg" alt="Light theme" class="w-4 lg:w-5 h-4 lg:h-5 hidden" id="icon-light" />
        </button>
        <a href="https://github.com" target="_blank" rel="noopener" class="flex items-center gap-1.5 lg:gap-2 px-2.5 lg:px-3 py-1 lg:py-1.5 bg-gray-100 dark:bg-gray-800 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-700 transition whitespace-nowrap">
          <img src="/assets/github.svg" alt="GitHub" class="w-3.5 lg:w-4 h-3.5 lg:h-4" />
          <span class="text-xs lg:text-sm font-medium text-gray-700 dark:text-gray-200">Visit</span>
          <span class="hidden sm:inline text-xs lg:text-sm font-medium text-gray-700 dark:text-gray-200">on GitHub</span>
        </a>
      </div>
    </header>
    
    <div id="mobile-nav" class="hidden md:hidden bg-white dark:bg-gray-900 border-b border-gray-200 dark:border-gray-700">
      <nav class="container mx-auto px-4 py-3 flex flex-col space-y-2">
        <a href="/docs" class="py-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition">Docs</a>
        <a href="/docs" class="py-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition">Features</a>
        <a href="/docs" class="py-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition">Roadmap</a>
        <a href="/docs" class="py-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition">Community</a>
        <a href="/docs" class="py-2 text-gray-600 dark:text-gray-300 hover:text-gray-900 dark:hover:text-gray-100 transition">Contribute</a>
      </nav>
    </div>

    <main class="container mx-auto px-4 md:px-6 max-w-7xl">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center py-12 lg:py-24">
        <div class="space-y-6 lg:pr-8">
          <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-4 sm:py-1.5 bg-blue-50 dark:bg-blue-900/20 rounded-full max-w-full">
            <span class="text-xs sm:text-sm font-semibold text-blue-600 dark:text-blue-400 whitespace-nowrap">Open Source</span>
            <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400 truncate">Built for the community, by the community</span>
          </div>
          
          <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-gray-900 dark:text-gray-100 tracking-tight">
            Yora Academy
          </h1>
          
          <p class="text-lg sm:text-xl md:text-2xl font-medium bg-gradient-to-r from-blue-600 to-indigo-600 dark:from-blue-400 dark:to-indigo-400 bg-clip-text text-transparent">
            The Open-Source Learning Platform
          </p>
          
          <p class="text-base sm:text-lg text-gray-600 dark:text-gray-300 max-w-md leading-relaxed">
            Yora Academy is an open-source documentation platform that runs from local development to deployment. Built as an experimental learning environment, it allows developers to explore concepts, test ideas, and gain hands-on experience building real-world projects.
          </p>
          
          <div class="flex flex-col sm:flex-row gap-2.5">
            <a href="/docs" class="inline-flex items-center justify-center px-5 py-2.5 sm:px-6 sm:py-3 lg:px-8 lg:py-4 bg-blue-600 text-white font-semibold rounded-xl shadow-lg shadow-blue-600/25 hover:bg-blue-700 transition-all hover:shadow-xl hover:shadow-blue-600/30 text-sm sm:text-base">
              Get Started
            </a>
            <a href="/docs" class="inline-flex items-center justify-center px-5 py-2.5 sm:px-6 sm:py-3 lg:px-8 lg:py-4 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 font-semibold rounded-xl border-2 border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700 transition text-sm sm:text-base">
              Documentation
            </a>
          </div>
          
          <div class="flex flex-wrap items-center gap-x-4 gap-y-1 pt-3">
            <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">MIT License</span>
            <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">100% Open Source</span>
            <span class="text-xs sm:text-sm text-gray-600 dark:text-gray-400">Made with ❤️ by Contributors</span>
          </div>
        </div>
        
        <div class="relative lg:pl-8 mt-12 lg:mt-0">
          <div class="w-full max-w-xs sm:max-w-sm md:max-w-md lg:max-w-lg mx-auto bg-gray-900/95 dark:bg-gray-900/95 backdrop-blur-xl rounded-2xl sm:rounded-3xl p-4 sm:p-5 lg:p-6 shadow-2xl shadow-gray-900/50 dark:shadow-blue-900/20 border border-gray-700/50 dark:border-gray-700/50">
            <div class="absolute inset-0 rounded-2xl sm:rounded-3xl bg-gradient-to-r from-blue-500/20 to-indigo-500/20 dark:from-blue-500/10 dark:to-indigo-500/10 pointer-events-none"></div>
            
            <div class="flex items-center gap-2 sm:gap-3 mb-3 sm:mb-4 pb-2 sm:pb-3 border-b border-gray-800">
              <div class="flex gap-1 sm:gap-1.5">
                <div class="w-2 h-2 sm:w-2.5 sm:h-2.5 bg-red-400 rounded-full"></div>
                <div class="w-2 h-2 sm:w-2.5 sm:h-2.5 bg-yellow-400 rounded-full"></div>
                <div class="w-2 h-2 sm:w-2.5 sm:h-2.5 bg-green-400 rounded-full"></div>
              </div>
              <span class="text-[10px] sm:text-xs text-gray-400">Dashboard</span>
            </div>
            
            <div class="grid grid-cols-4 sm:grid-cols-6 gap-2 sm:gap-3 w-full min-w-0">
              <div class="col-span-4 sm:col-span-1 space-y-1 sm:space-y-1.5">
                <div class="text-[8px] sm:text-[10px] text-gray-400 uppercase tracking-wider mb-1 sm:mb-1.5">Navigation</div>
                <div class="space-y-0.5 sm:space-y-1">
                  <div class="px-1.5 py-1 sm:px-2 sm:py-1.5 text-[10px] sm:text-xs text-white bg-blue-500/20 rounded-md truncate">Overview</div>
                  <div class="px-1.5 py-1 sm:px-2 sm:py-1.5 text-[10px] sm:text-xs text-gray-400 hover:text-white rounded-md transition truncate">Modules</div>
                  <div class="px-1.5 py-1 sm:px-2 sm:py-1.5 text-[10px] sm:text-xs text-gray-400 hover:text-white rounded-md transition truncate">Guides</div>
                  <div class="px-1.5 py-1 sm:px-2 sm:py-1.5 text-[10px] sm:text-xs text-gray-400 hover:text-white rounded-md transition truncate">API</div>
                </div>
              </div>
              
              <div class="col-span-4 sm:col-span-5 space-y-2 sm:space-y-3">
                <div class="relative">
                  <input type="search" placeholder="Search..." class="w-full px-2 py-1.5 sm:px-3 sm:py-2 pl-6 sm:pl-8 bg-gray-800/50 border border-gray-700 rounded-md text-white placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-blue-500/50 text-[10px] sm:text-xs" />
                  <svg class="absolute left-1.5 sm:left-2.5 top-1.5 sm:top-2 w-3 h-3 sm:w-3.5 sm:h-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                </div>
                
                <div class="space-y-1.5 sm:space-y-2">
                  <div class="h-2.5 sm:h-3 bg-gray-700 rounded-full w-3/4"></div>
                  <div class="h-2.5 sm:h-3 bg-gray-700 rounded-full w-1/2"></div>
                  <div class="h-2.5 sm:h-3 bg-gray-700/50 rounded-full w-2/3"></div>
                </div>
                
                <div class="grid grid-cols-2 gap-1.5 sm:gap-2">
                  <div class="p-2 sm:p-3 bg-gray-800/50 rounded-xl border border-gray-700">
                    <div class="h-2 sm:h-2.5 bg-blue-500/50 rounded-full w-10 sm:w-12 mb-1 sm:mb-1.5"></div>
                    <div class="h-1 sm:h-1.5 bg-gray-700 rounded-full w-8 sm:w-10"></div>
                  </div>
                  <div class="p-2 sm:p-3 bg-gray-800/50 rounded-xl border border-gray-700">
                    <div class="h-2 sm:h-2.5 bg-green-500/50 rounded-full w-12 sm:w-14 mb-1 sm:mb-1.5"></div>
                    <div class="h-1 sm:h-1.5 bg-gray-700 rounded-full w-6 sm:w-8"></div>
                  </div>
                </div>
                
                <div class="bg-gray-800/50 rounded-xl p-2 sm:p-3 border border-gray-700">
                  <div class="flex items-center gap-1 sm:gap-1.5 mb-1.5 sm:mb-2">
                    <div class="w-2.5 h-2.5 sm:w-3 sm:h-3 bg-blue-500/50 rounded"></div>
                    <div class="h-1.5 sm:h-2 bg-gray-600 rounded-full w-12 sm:w-16"></div>
                  </div>
                  <pre class="text-[9px] sm:text-[10px] text-gray-300 overflow-x-auto"><code><span class="text-blue-400">import</span> <span class="text-green-400">module</span> <span class="text-yellow-400">from</span> <span class="text-purple-400">'yora'</span></code></pre>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </main>

    <section class="container mx-auto px-4 md:px-6 max-w-7xl pb-16 lg:pb-20">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-2.5 sm:gap-3 max-w-5xl mx-auto">
        <div class="bg-white/70 dark:bg-gray-800/50 backdrop-blur-sm rounded-xl sm:rounded-2xl p-3 sm:p-4 lg:p-5 border border-gray-200 dark:border-gray-700 text-center">
          <div class="text-lg sm:text-xl lg:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-0.5">1.2k+</div>
          <div class="text-[10px] sm:text-xs lg:text-sm text-gray-600 dark:text-gray-400">GitHub Stars</div>
        </div>
        <div class="bg-white/70 dark:bg-gray-800/50 backdrop-blur-sm rounded-xl sm:rounded-2xl p-3 sm:p-4 lg:p-5 border border-gray-200 dark:border-gray-700 text-center">
          <div class="text-lg sm:text-xl lg:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-0.5">200+</div>
          <div class="text-[10px] sm:text-xs lg:text-sm text-gray-600 dark:text-gray-400">Contributors</div>
        </div>
        <div class="bg-white/70 dark:bg-gray-800/50 backdrop-blur-sm rounded-xl sm:rounded-2xl p-3 sm:p-4 lg:p-5 border border-gray-200 dark:border-gray-700 text-center">
          <div class="text-lg sm:text-xl lg:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-0.5">45+</div>
          <div class="text-[10px] sm:text-xs lg:text-sm text-gray-600 dark:text-gray-400">Forks</div>
        </div>
        <div class="bg-white/70 dark:bg-gray-800/50 backdrop-blur-sm rounded-xl sm:rounded-2xl p-3 sm:p-4 lg:p-5 border border-gray-200 dark:border-gray-700 text-center">
          <div class="text-lg sm:text-xl lg:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-0.5">30+</div>
          <div class="text-[10px] sm:text-xs lg:text-sm text-gray-600 dark:text-gray-400">Modules</div>
        </div>
        <div class="bg-white/70 dark:bg-gray-800/50 backdrop-blur-sm rounded-xl sm:rounded-2xl p-3 sm:p-4 lg:p-5 border border-gray-200 dark:border-gray-700 text-center col-span-2 sm:col-span-1">
          <div class="text-lg sm:text-xl lg:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-0.5">MIT</div>
          <div class="text-[10px] sm:text-xs lg:text-sm text-gray-600 dark:text-gray-400">License</div>
        </div>
      </div>
    </section>

    <footer class="border-t border-gray-200 dark:border-gray-800 py-8 bg-white/50 dark:bg-gray-900/50 backdrop-blur-sm">
      <div class="container mx-auto px-4 md:px-6 text-center text-sm text-gray-600 dark:text-gray-400">
        &copy; {new Date().getFullYear()} Yora Academy. All rights reserved.
      </div>
    </footer>

    <script>
      const themeToggle = document.getElementById('theme-toggle');
      const mobileThemeToggle = document.getElementById('mobile-theme-toggle');
      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileNav = document.getElementById('mobile-nav');
      const iconDark = document.getElementById('icon-dark');
      const iconLight = document.getElementById('icon-light');
      const mobileIconDark = document.getElementById('mobile-icon-dark');
      const mobileIconLight = document.getElementById('mobile-icon-light');
      const htmlEl = document.documentElement;
      
      const currentTheme = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      if (currentTheme === 'dark') {
        htmlEl.classList.add('dark');
        iconDark?.classList.add('hidden');
        iconLight?.classList.remove('hidden');
        mobileIconDark?.classList.add('hidden');
        mobileIconLight?.classList.remove('hidden');
      }

      const toggleTheme = () => {
        const isDark = htmlEl.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        if (isDark) {
          iconDark?.classList.add('hidden');
          iconLight?.classList.remove('hidden');
          mobileIconDark?.classList.add('hidden');
          mobileIconLight?.classList.remove('hidden');
        } else {
          iconDark?.classList.remove('hidden');
          iconLight?.classList.add('hidden');
          mobileIconDark?.classList.remove('hidden');
          mobileIconLight?.classList.add('hidden');
        }
      };
      
      themeToggle?.addEventListener('click', toggleTheme);
      mobileThemeToggle?.addEventListener('click', toggleTheme);

      mobileMenuBtn?.addEventListener('click', () => {
        if (mobileNav) {
          mobileNav.classList.toggle('hidden');
        }
      });
    </script>
  </body>
</html>